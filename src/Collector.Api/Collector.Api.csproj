<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <OutputPath>../../bin/api</OutputPath>
    <UserSecretsId>collector-api-0a1f5f8b-2c3d-4e5f-9f0a-1b2c3d4e5f6a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Collector\Collector.csproj" />
  </ItemGroup>

  <!--
    The collector's appsettings.json and migrate-mode.txt ride along with the project
    reference. Published next to the API's own appsettings.json they stopped the publish
    (NETSDK1152), and the API must never read the collector's settings: drop them before
    the SDK checks for duplicates.
  -->
  <Target Name="ExcludeCollectorFilesFromPublish" AfterTargets="ComputeFilesToPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <PropertyGroup>
      <_CollectorDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Collector/'))</_CollectorDir>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').StartsWith('$(_CollectorDir)')) and ('%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json' or '%(ResolvedFileToPublish.RelativePath)' == 'migrate-mode.txt')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Enrichers.Process" />
  </ItemGroup>

</Project>
