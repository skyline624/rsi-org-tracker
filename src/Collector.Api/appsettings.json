{
  "DataDir": "../../data",
  "Api": {
    "AdminApiKey": "",
    "Jwt": { "PrivateKeyPath": "" },
    "JwtIssuer": "sc-tracker-api",
    "JwtAudience": "sc-tracker-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "Cors": {
      "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
    },
    "Swagger": {
      "Enabled": false
    },
    "RateLimit": {
      "WindowSeconds": 60,
      "UserPermitLimit": 600,
      "AnonymousPermitLimit": 60,
      "Login": { "PermitLimit": 10, "WindowSeconds": 300 },
      "DiscordIngest": { "PermitLimit": 20, "WindowSeconds": 600 }
    }
  },
  "Discord": {
    "Ingest": { "PublicUrl": null, "CertificateSha256": null },
    "Retention": { "SyncLogDays": 365, "DepartedAccountDays": 730 }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
