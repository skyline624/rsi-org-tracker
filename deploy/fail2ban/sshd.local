# /etc/fail2ban/jail.d/sshd.local
[sshd]
enabled  = true
backend  = systemd
# Ubuntu 24.04 runs sshd as ssh.service: the filter's default match (sshd.service)
# sees none of its log lines, and the jail would never ban anyone.
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd
maxretry = 5
findtime = 10m
bantime  = 1h
# Loopback and the Tailscale range (admin access path) are never banned.
ignoreip = 127.0.0.1/8 ::1 100.64.0.0/10
