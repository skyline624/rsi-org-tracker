[Unit]
Description=SC Org Tracker - Collector (collection loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sc-tracker/current/collector
EnvironmentFile=/etc/sc-tracker/collector.env
# Applies the tracker.db migrations and exits: `systemctl restart` returns once the
# schema is ready (deploy.sh then restarts the API on it). A long migration must not
# be cut by the default 90 s start timeout.
ExecStartPre=/home/ubuntu/.dotnet/dotnet /home/ubuntu/sc-tracker/current/collector/Collector.dll --migrate
TimeoutStartSec=30min
ExecStart=/home/ubuntu/.dotnet/dotnet /home/ubuntu/sc-tracker/current/collector/Collector.dll
Restart=always
RestartSec=10
# SIGTERM stops the generic host; give an in-flight organisation time to commit.
TimeoutStopSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
