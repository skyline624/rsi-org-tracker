# /etc/sc-tracker/web.env — root:ubuntu 0640. Never commit real values.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=127.0.0.1
PORT=3000

# Lot 6 switches the API to plain HTTP on loopback and drops the TLS bypass.
API_BASE_URL=https://127.0.0.1:5001
NODE_TLS_REJECT_UNAUTHORIZED=0

# Stable across builds so Server Action payloads survive a redeploy.
# Generate once: openssl rand -base64 32 (read by deploy.sh at build time too).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
