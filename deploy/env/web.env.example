# /etc/sc-tracker/web.env — root:ubuntu 0640. Never commit real values.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=127.0.0.1
PORT=3000

# The API listens on plain HTTP on loopback: no certificate, no TLS bypass.
API_BASE_URL=http://127.0.0.1:5000

# Stable across builds so Server Action payloads survive a redeploy.
# Generate once: openssl rand -base64 32 (read by deploy.sh at build time too).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
