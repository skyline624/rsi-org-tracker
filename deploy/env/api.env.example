# /etc/sc-tracker/api.env — root:ubuntu 0640. Never commit real values.
HOME=/home/ubuntu
DOTNET_ROOT=/home/ubuntu/.dotnet
DOTNET_CLI_TELEMETRY_OPTOUT=1
COLLECTOR_DATA_DIR=/home/ubuntu/collector-dotnet/bin/data

# Lot 6 switches these to Production and http://127.0.0.1:5000 only.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://127.0.0.1:5001;http://127.0.0.1:5000

# RSA key that signs access tokens (RS256). Owned by ubuntu, mode 0600, >= 2048 bits:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out /etc/sc-tracker/jwt/private.pem
COLLECTOR_API_Api__Jwt__PrivateKeyPath=/etc/sc-tracker/jwt/private.pem

# Until lot 6, Api:AdminApiKey still comes from the .NET user-secrets store in
# $HOME (loaded unconditionally by Program.cs). Api:JwtSecret is no longer used.
# Discord bot token (previously in sc-api.service.d/discord.conf).
Discord__BotToken=
