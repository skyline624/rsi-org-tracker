# /etc/sc-tracker/api.env — root:ubuntu 0640. Never commit real values.
HOME=/home/ubuntu
DOTNET_ROOT=/home/ubuntu/.dotnet
DOTNET_CLI_TELEMETRY_OPTOUT=1
COLLECTOR_DATA_DIR=/home/ubuntu/collector-dotnet/bin/data

# Lot 6 switches these to Production and http://127.0.0.1:5000 only.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://127.0.0.1:5001;http://127.0.0.1:5000

# Until lot 6, Api:JwtSecret and Api:AdminApiKey still come from the .NET
# user-secrets store in $HOME (loaded unconditionally by Program.cs).
# Discord bot token (previously in sc-api.service.d/discord.conf).
Discord__BotToken=
